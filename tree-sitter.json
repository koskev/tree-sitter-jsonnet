{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "jsonnet",
      "camelcase": "Jsonnet",
      "title": "Jsonnet",
      "scope": "source.jsonnet",
      "file-types": [
        "jsonnet",
        "libsonnet"
      ],
      "injection-regex": "^jsonnet$",
      "class-name": "TreeSitterJsonnet"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Jsonnet grammar for tree-sitter",
    "authors": [
      {
        "name": "sourcegraph"
      },
      {
        "name": "Kevin Köster"
      }
    ],
    "links": {
      "repository": "https://github.com/koskev/tree-sitter-jsonnet"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": true
  }
}
